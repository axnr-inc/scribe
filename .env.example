# Copy to .env and fill in. SCRIBE requires only OPENROUTER_API_KEY +
# one of {FIREWORKS_API_KEY, BASETEN_API_KEY}; others are optional.

# === REQUIRED: spec agent + review agent (GPT-5 via OpenRouter) ===
OPENROUTER_API_KEY=

# === REQUIRED: Kimi-K2.6 ReAct executor — set at least one ===
# Fireworks (primary). Model id: accounts/fireworks/models/kimi-k2p6
FIREWORKS_API_KEY=

# Optional second Fireworks account (different rate-limit pool, used to
# fan out executor calls across two keys for higher throughput).
FIREWORKS_API_KEY2=

# Alternative provider for Kimi (Baseten). Model id: moonshotai/Kimi-K2.6
BASETEN_API_KEY=

# === OPTIONAL ===
# Anthropic — for legacy Sonnet/Opus planner experiments.
ANTHROPIC_API_KEY=

# Direct OpenAI — currently unused; left in place for future experiments
# (e.g. swapping the spec agent off OpenRouter onto api.openai.com).
OPENAI_API_KEY=

# Optional Python interpreter for the executor's REPL (must have pandas/numpy).
# Defaults to whatever `python3` resolves to in your PATH.
# PYTHON_BIN=/path/to/your/conda/env/bin/python3
